{
  "name": "mik-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "node server/index.mjs",
    "import:wix-blog": "node scripts/import-wix-blog.mjs",
    "prerender": "node scripts/prerender.mjs",
    "build": "npm run prerender && vite build && npm run postbuild:static && npm run check:seo",
    "postbuild:static": "node scripts/postbuild-static.mjs",
    "check:seo": "node scripts/check-static-seo.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:migration": "node scripts/check-live-migration.mjs",
    "check:responsive": "node scripts/audit-responsive.mjs",
    "lint": "eslint . --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "smoke": "node scripts/smoke-end-to-end.mjs",
    "smoke:wix": "node scripts/smoke-wix-checkout.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@wix/ecom": "^1.0.2416",
    "@wix/loyalty": "^1.0.426",
    "@wix/members": "^1.0.509",
    "@wix/sdk": "^1.21.16",
    "autoprefixer": "^10.5.0",
    "lucide-react": "^1.16.0",
    "postcss": "^8.5.15",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@types/react": "^18.2.15",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react": "^4.0.3",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.3",
    "vite": "^4.4.5"
  }
}
